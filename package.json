{
  "name": "@ltatarev/react-native-icloud",
  "version": "0.1.0",
  "description": "iCloud Drive container documents, file transfer and key-value store for React Native on iOS",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "ltatarev-react-native-icloud-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./testing": {
      "ltatarev-react-native-icloud-source": "./src/testing/index.ts",
      "types": "./lib/typescript/src/testing/index.d.ts",
      "default": "./lib/module/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/*.test.ts"
  ],
  "scripts": {
    "example": "yarn workspace @ltatarev/react-native-icloud-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ios",
    "icloud",
    "icloud-drive",
    "ubiquity-container",
    "nsubiquitouskeyvaluestore",
    "sync",
    "nitro-modules"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ltatarev/react-native-icloud.git"
  },
  "author": "Lucija Tatarević <lucija.tatarevic@gmail.com> (https://github.com/ltatarev)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ltatarev/react-native-icloud/issues"
  },
  "homepage": "https://github.com/ltatarev/react-native-icloud#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "babel-jest": "^30.5.2",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "nitrogen": "0.36.5",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-builder-bob": "^0.43.2",
    "react-native-nitro-modules": "0.36.5",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": true,
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "eslint",
      "jest"
    ],
    "version": "0.63.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  }
}
